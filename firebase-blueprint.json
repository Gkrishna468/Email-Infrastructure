{
  "entities": {
    "Email": {
      "title": "Email",
      "description": "Recruitment related email",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "subject": { "type": "string" },
        "snippet": { "type": "string" },
        "from": { "type": "string" },
        "date": { "type": "string" },
        "match_score": {
          "type": "object",
          "properties": {
            "score": { "type": "number" },
            "reasons": { "type": "array" }
          }
        },
        "metadata": {
          "type": "object",
          "properties": {
            "candidateName": { "type": "string" },
            "role": { "type": "string" },
            "experience": { "type": "string" }
          }
        },
        "outreach_draft": { "type": "string" },
        "userId": { "type": "string" }
      }
    },
    "GmailToken": {
      "title": "Gmail OAuth Token",
      "description": "Sensitive OAuth tokens for Gmail access",
      "type": "object",
      "properties": {
        "access_token": { "type": "string" },
        "refresh_token": { "type": "string" },
        "expiry_date": { "type": "number" },
        "scope": { "type": "string" },
        "token_type": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/emails/{emailId}": {
      "schema": "Email",
      "description": "Collection of processed recruitment emails"
    },
    "/gmail_tokens/{userId}": {
      "schema": "GmailToken",
      "description": "Sensitive user Gmail OAuth tokens"
    }
  }
}
